# ==============================================================================
# ListingLab Environment Configuration (.env.example)
# Open-Weight AI E-commerce Listing Generator for Side Hustlers
# ==============================================================================

# Server Network Configuration
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Open-Weight AI Provider Configuration
# Choose one of: groq | openrouter | huggingface | ollama | custom
# ------------------------------------------------------------------------------
AI_PROVIDER=groq

# Primary Open-Weight Model Identifier:
# - Groq (Production / Free Tier): openai/gpt-oss-120b, llama-3.1-8b-instant, mixtral-8x7b-32768
# - OpenRouter (Free Tier): meta-llama/llama-3.3-70b-instruct:free, qwen/qwen-2.5-72b-instruct:free
# - HuggingFace (Serverless): meta-llama/Llama-3.2-3B-Instruct, Qwen/Qwen2.5-7B-Instruct
# - Ollama (Local): llama3.2, mistral, qwen2.5
AI_MODEL=openai/gpt-oss-120b

# Base URL of the OpenAI-compatible inference endpoint:
# - Groq: https://api.groq.com/openai/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - HuggingFace: https://api-inference.huggingface.co/v1
# - Ollama (Local): http://localhost:11434/v1
AI_BASE_URL=https://api.groq.com/openai/v1

# API Key for Remote Providers (Keep confidential! Server-side only)
# Leave blank or set to 'ollama' if running a local model with Ollama.
# Obtain a free Groq key at: https://console.groq.com/keys
AI_API_KEY=your_open_weight_api_key_here

# Request timeout in milliseconds (default: 45000)
AI_TIMEOUT_MS=45000
